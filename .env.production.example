# =============================================================================
# DYVIN AI — PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.production (never commit .env.production to git).
# All variables marked REQUIRED must be set before deploying to production.
# Variables marked OPTIONAL can be left unset to disable the related feature.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# REQUIRED — Full connection string for the production PostgreSQL instance.
# Example (managed DB): postgresql://dyvin:<password>@<host>:5432/dyvin_db?schema=public&sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?schema=public

# Used by Docker Compose to provision the postgres container
POSTGRES_USER=<your-db-user>
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_DB=<your-db-name>

# ─── Cache & Queue (Redis) ────────────────────────────────────────────────────
# REQUIRED — Redis connection URL for BullMQ job queues and session caching.
REDIS_URL=redis://<host>:6379

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED — Minimum 64 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never reuse development or test values.
JWT_SECRET=<generate-a-64-char-random-hex-string>

# ─── Payment Providers ────────────────────────────────────────────────────────
# OPTIONAL until Stripe is fully integrated (P1).
# STRIPE_WEBHOOK_SECRET is REQUIRED once live webhooks are enabled — without it
# all inbound Stripe webhook events will be rejected.
STRIPE_SECRET_KEY=sk_live_<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=pk_live_<your-stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-signing-secret>

# OPTIONAL — Only required if Razorpay is enabled as a payment provider.
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>

# ─── AI Provider Keys ────────────────────────────────────────────────────────
# REQUIRED for live AI visibility analysis. Without these, AI features
# will fall back to mock/unavailable responses.
OPENAI_API_KEY=sk-proj-<your-openai-key>
ANTHROPIC_API_KEY=sk-ant-<your-anthropic-key>
GOOGLE_API_KEY=<your-google-api-key>
PERPLEXITY_API_KEY=pplx-<your-perplexity-key>

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# REQUIRED for email verification on registration, password reset, and billing
# receipts. Choose one provider (Resend recommended).
# RESEND_API_KEY=re_<your-resend-api-key>
# SENDGRID_API_KEY=SG.<your-sendgrid-key>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=<smtp-user>
# SMTP_PASS=<smtp-password>
# SMTP_FROM=noreply@dyvin.ai
