model SystemHealthCheck {
  id        String   @id @default(uuid())
  status    String
  checkedAt DateTime @default(now())

  @@map("system_health_checks")
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  passwordHash            String
  firstName               String
  lastName                String
  isEmailVerified         Boolean                 @default(false)
  avatarUrl               String?
  status                  UserStatus              @default(ACTIVE)
  deletedAt               DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  memberships             OrganizationMember[]
  projectMemberships      ProjectMember[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations         Invitation[]            @relation("InvitedBy")
  auditLogs               AuditLog[]
  scans                   Scan[]                  @relation("CreatedBy")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  alertSubscriptions      AlertSubscription[]
  comments                Comment[]
  mentions                Mention[]               @relation("MentionedUser")
  activityLogs            ActivityLog[]
  aiSearchPrompts         AISearchPrompt[]        @relation("PromptOwner")

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Organization {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  logoUrl     String?
  deletedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  members          OrganizationMember[]
  invitations      Invitation[]
  projects         Project[]
  auditLogs        AuditLog[]
  subscriptions    OrganizationSubscription[]
  paymentCustomers PaymentCustomer[]
  invoices         Invoice[]
  usageQuotas      UsageQuota[]
  creditBalances   CreditBalance[]
  billingAudits    BillingAudit[]
  budgets          OrganizationBudget[]
  aiSearchProjects AISearchProject[]
  competitors      Competitor[]
  visibilityProfiles AIVisibilityProfile[]
  keywords         Keyword[]
  campaigns        KeywordCampaign[]
  strategies       Strategy[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           Role             @default(MEMBER)
  tokenHash      String           @unique
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  invitedById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@map("invitations")
}

model RefreshToken {
  id                String       @id @default(uuid())
  userId            String
  tokenHash         String       @unique
  expiresAt         DateTime
  isRevoked         Boolean      @default(false)
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime     @default(now())

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model AuditLog {
  id             String        @id @default(uuid())
  userId         String?
  organizationId String?
  action         String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Project {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  slug           String            @unique
  description    String?
  industry       String?
  businessSize   String?
  country        String?
  timezone       String            @default("UTC")
  logo           String?
  favicon        String?
  primaryDomain  String            @unique
  status         ProjectStatus     @default(ACTIVE)
  visibility     ProjectVisibility @default(TEAM)
  createdBy      String
  updatedBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websites            Website[]
  members             ProjectMember[]
  settings            ProjectSettings?
  tags                ProjectTag[]
  scans               Scan[]
  knowledgeGraphs     KnowledgeGraph[]
  analyses            VisibilityAnalysis[]
  verifications       Verification[]
  improvements        ImprovementHistory[]
  monitoringJobs      MonitoringJob[]
  websiteSnapshots    WebsiteSnapshot[]
  scanSchedules       ScanSchedule[]
  automationRules     AutomationRule[]
  automationHistories AutomationHistory[]
  alerts              Alert[]
  alertRules          AlertRule[]
  generatedContents   GeneratedContent[]
  reports             Report[]
  dashboardWidgets    DashboardWidget[]
  analyticsMetrics    AnalyticsMetric[]
  analyticsSnapshots  AnalyticsSnapshot[]
  trendAnalyses       TrendAnalysis[]
  aiSearchProjects    AISearchProject[]

  @@index([organizationId])
  @@index([slug])
  @@index([primaryDomain])
  @@index([deletedAt])
  @@map("projects")
}

model Website {
  id                 String               @id @default(uuid())
  projectId          String
  url                String
  domain             String
  subdomain          String?
  isPrimary          Boolean              @default(false)
  verificationStatus VerificationStatus   @default(UNVERIFIED)
  verificationMethod VerificationMethod?
  verifiedAt         DateTime?
  lastScannedAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifications      WebsiteVerification[]
  scans              Scan[]
  monitoringJobs     MonitoringJob[]

  @@index([projectId])
  @@index([domain])
  @@index([deletedAt])
  @@map("websites")
}

model WebsiteVerification {
  id                String             @id @default(uuid())
  websiteId         String
  method            VerificationMethod
  verificationToken String
  status            VerificationStatus @default(PENDING)
  attempts          Int                @default(0)
  lastAttemptAt     DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())

  website           Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([status])
  @@map("website_verifications")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ProjectSettings {
  id                     String        @id @default(uuid())
  projectId              String        @unique
  language               String        @default("en")
  scanFrequency          ScanFrequency @default(WEEKLY)
  notificationPreferences Json?
  aiProvidersEnabled     Json?
  defaultReportSettings  Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  project                Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model ProjectTag {
  id        String   @id @default(uuid())
  projectId String
  name      String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_tags")
}

model Scan {
  id              String       @id @default(uuid())
  projectId       String
  websiteId       String
  status          ScanStatus   @default(QUEUED)
  pagesDiscovered Int          @default(0)
  pagesCrawled    Int          @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  website         Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdByUser   User         @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)

  pages               ScanPage[]
  assets              ScanAsset[]
  robotsFiles         RobotsFile[]
  sitemaps            Sitemap[]
  technologies        Technology[]
  securityFindings    SecurityFinding[]
  analyses            VisibilityAnalysis[]
  previousInRuns      VerificationRun[]    @relation("PreviousScan")
  currentInRuns       VerificationRun[]    @relation("CurrentScan")
  websiteSnapshots    WebsiteSnapshot[]

  @@index([projectId])
  @@index([websiteId])
  @@index([status])
  @@map("scans")
}

model ScanPage {
  id              String      @id @default(uuid())
  scanId          String
  url             String
  domain          String
  subdomain       String?
  path            String
  statusCode      Int
  contentType     String?
  title           String?
  metaDescription String?
  wordCount       Int         @default(0)
  readingTime     Int         @default(0)
  contentHash     String?
  language        String?
  canonicalUrl    String?
  isCanonical     Boolean     @default(true)
  depth           Int         @default(0)
  headers         Json?
  createdAt       DateTime    @default(now())

  scan            Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  assets          ScanAsset[]
  metadata        ScanMetadata[]
  structuredData  StructuredData[]
  canonicalPages  CanonicalPage[]
  technologies    Technology[]
  securityFindings SecurityFinding[]
  languageDetections LanguageDetection[]
  contentHashes   ContentHash[]

  @@index([scanId])
  @@index([url])
  @@index([domain])
  @@map("scan_pages")
}

model ScanAsset {
  id         String   @id @default(uuid())
  scanId     String
  scanPageId String
  type       AssetType
  url        String
  altText    String?
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanPage   ScanPage @relation(fields: [scanPageId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([scanPageId])
  @@index([type])
  @@map("scan_assets")
}

model ScanMetadata {
  id         String   @id @default(uuid())
  scanPageId String
  key        String
  value      String
  createdAt  DateTime @default(now())

  scanPage   ScanPage @relation(fields: [scanPageId], references: [id], onDelete: Cascade)

  @@index([scanPageId])
  @@index([key])
  @@map("scan_metadata")
}

model StructuredData {
  id         String   @id @default(uuid())
  scanPageId String
  type       String
  rawJson    Json
  createdAt  DateTime @default(now())

  scanPage   ScanPage @relation(fields: [scanPageId], references: [id], onDelete: Cascade)

  @@index([scanPageId])
  @@index([type])
  @@map("structured_data")
}

model RobotsFile {
  id         String   @id @default(uuid())
  scanId     String
  url        String
  rawContent String?
  isAllowed  Boolean  @default(true)
  sitemaps   Json?
  createdAt  DateTime @default(now())

  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("robots_files")
}

model Sitemap {
  id             String   @id @default(uuid())
  scanId         String
  url            String
  urlsDiscovered Json?
  pageCount      Int      @default(0)
  createdAt      DateTime @default(now())

  scan           Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("sitemaps")
}

model CanonicalPage {
  id              String   @id @default(uuid())
  scanId          String
  scanPageId      String
  canonicalUrl    String
  isSelfCanonical Boolean  @default(true)
  createdAt       DateTime @default(now())

