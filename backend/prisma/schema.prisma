// ==========================================
// Sprint 23: AI Action Engine Models & Enums
// ==========================================

enum ActionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  REJECTED
  WAITING_APPROVAL
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionType {
  GENERATE_BLOG
  GENERATE_FAQ
  GENERATE_LANDING_PAGE
  GENERATE_COMPARISON_PAGE
  GENERATE_PRODUCT_PAGE
  GENERATE_SCHEMA
  GENERATE_JSON_LD
  GENERATE_META_TAGS
  GENERATE_TITLE
  GENERATE_DESCRIPTION
  GENERATE_SOCIAL_POSTS
  GENERATE_LINKEDIN_POST
  GENERATE_REDDIT_ANSWER
  GENERATE_X_THREAD
  GENERATE_PRESS_RELEASE
  GENERATE_DOCUMENTATION
  GENERATE_KNOWLEDGE_BASE
  GENERATE_HELP_CENTER
  GENERATE_CHANGELOG
  GENERATE_EMAIL_CAMPAIGN
  GENERATE_OUTREACH_CAMPAIGN
  INTERNAL_LINKING
  BROKEN_LINK_SUGGESTIONS
  SCHEMA_IMPROVEMENTS
  HEADING_OPTIMIZATION
  CONTENT_EXPANSION
  CANONICAL_SUGGESTIONS
  TOPIC_EXPANSION
  ENTITY_OPTIMIZATION
  IMPROVE_PROMPT_COVERAGE
  INCREASE_CITATION_PROBABILITY
  KNOWLEDGE_GAP_FILLING
  AUTHORITY_RECOMMENDATIONS
  SOURCE_DIVERSITY
  BRAND_CONSISTENCY
}

enum ActionTriggerType {
  MANUAL
  SCHEDULED
  EVENT_DRIVEN
  WEBHOOK
  API
}

enum ExecutionMode {
  SEQUENTIAL
  PARALLEL
  CONDITIONAL
}

enum ActionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RollbackStatus {
  NONE
  PENDING
  SUCCESS
  FAILED
}

model Action {
  id             String         @id @default(uuid())
  organizationId String
  title          String
  description    String?
  type           ActionType
  status         ActionStatus   @default(PENDING)
  priority       ActionPriority @default(MEDIUM)
  triggerType    ActionTriggerType @default(MANUAL)
  payloadJson    Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  executions     ActionExecution[]
  approvals      ActionApproval[]
  artifacts      ActionArtifact[]
  histories      ActionHistory[]
  results        ActionResult[]
  logs           ActionLog[]

  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@map("actions")
}

model ActionTemplate {
  id          String     @id @default(uuid())
  name        String     @unique
  actionType  ActionType
  templateBody String
  defaultParams Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("action_templates")
}

model ActionExecution {
  id           String       @id @default(uuid())
  actionId     String
  status       ActionStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime     @default(now())

  action       Action       @relation(fields: [actionId], references: [id], onDelete: Cascade)
  outputs      ActionOutput[]

  @@index([actionId])
  @@map("action_executions")
}

model ActionWorkflow {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  mode           ExecutionMode @default(SEQUENTIAL)
  isPublished    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  steps          ActionWorkflowStep[]
  runs           ActionRun[]

  @@index([organizationId])
  @@map("action_workflows")
}

model ActionWorkflowStep {
  id          String        @id @default(uuid())
  workflowId  String
  stepOrder   Int
  title       String
  actionType  ActionType
  configJson  Json?
  createdAt   DateTime      @default(now())

  workflow    ActionWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("action_workflow_steps")
}

model ActionRun {
  id          String       @id @default(uuid())
  workflowId  String
  status      ActionStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  workflow    ActionWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("action_runs")
}

model ActionQueue {
  id          String   @id @default(uuid())
  queueName   String
  jobCount    Int      @default(0)
  isPaused    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("action_queues")
}

model ActionDependency {
  id            String   @id @default(uuid())
  parentActionId String
  childActionId  String
  createdAt     DateTime @default(now())

  @@index([parentActionId])
  @@index([childActionId])
  @@map("action_dependencies")
}

model ActionApproval {
  id          String               @id @default(uuid())
  actionId    String
  approverId  String
  status      ActionApprovalStatus @default(PENDING)
  notes       String?
  approvedAt  DateTime?
  createdAt   DateTime             @default(now())

  action      Action         @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("action_approvals")
}

model ActionHistory {
  id          String   @id @default(uuid())
  actionId    String
  status      ActionStatus
  changedBy   String?
  timestamp   DateTime @default(now())

  action      Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("action_histories")
}

model ActionResult {
  id          String   @id @default(uuid())
  actionId    String
  summaryText String
  dataJson    Json?
  createdAt   DateTime @default(now())

  action      Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("action_results")
}

model ActionLog {
  id          String   @id @default(uuid())
  actionId    String
  logLevel    String   @default("INFO")
  message     String
  createdAt   DateTime @default(now())

  action      Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("action_logs")
}

model ActionTrigger {
  id          String            @id @default(uuid())
  title       String
  triggerType ActionTriggerType @default(MANUAL)
  configJson  Json?
  createdAt   DateTime          @default(now())

  @@map("action_triggers")
}

model ActionCondition {
  id          String   @id @default(uuid())
  fieldKey    String
  operator    String   @default("EQUALS")
  valueStr    String
  createdAt   DateTime @default(now())

  @@map("action_conditions")
}

model ActionVariable {
  id          String   @id @default(uuid())
  varKey      String   @unique
  varValue    String
  createdAt   DateTime @default(now())

  @@map("action_variables")
}

model ActionArtifact {
  id          String   @id @default(uuid())
  actionId    String
  title       String
  fileUrl     String?
  contentBody String?
  contentType String   @default("text/markdown")
  createdAt   DateTime @default(now())

  action      Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("action_artifacts")
}

model ActionOutput {
  id          String          @id @default(uuid())
  executionId String
  outputType  String
  payload     Json?
  createdAt   DateTime        @default(now())

  execution   ActionExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("action_outputs")
}

model ActionMetric {
  id          String   @id @default(uuid())
  metricKey   String
  metricValue Float    @default(0.0)
  recordedAt  DateTime @default(now())

  @@map("action_metrics")
}

model ActionSnapshot {
  id           String   @id @default(uuid())
  snapshotDate DateTime @default(now())
  stateJson    Json
  createdAt    DateTime @default(now())

  @@map("action_snapshots")
}

model ActionTimeline {
  id          String   @id @default(uuid())
  eventDate   DateTime @default(now())
  title       String
  createdAt   DateTime @default(now())

  @@index([eventDate])
  @@map("action_timelines")
}

model ActionFailure {
  id           String   @id @default(uuid())
  actionId     String
  errorCode    String
  errorMessage String
  failedAt     DateTime @default(now())

  @@index([actionId])
  @@map("action_failures")
}

model ActionRetry {
  id          String   @id @default(uuid())
  actionId    String
  retryCount  Int      @default(1)
  retriedAt   DateTime @default(now())

  @@index([actionId])
  @@map("action_retries")
}

model ActionRollback {
  id          String         @id @default(uuid())
  actionId    String
  status      RollbackStatus @default(PENDING)
  reason      String?
  executedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([actionId])
  @@map("action_rollbacks")
}

model ActionAutomation {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("action_automations")
}

model ActionPlaybook {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   @default("RECOVER_VISIBILITY")
  description String
  stepsJson   Json
  createdAt   DateTime @default(now())

  @@map("action_playbooks")
}

model ActionPolicy {
  id          String   @id @default(uuid())
  policyName  String   @unique
  rulesJson   Json
  createdAt   DateTime @default(now())

  @@map("action_policies")
}

model ActionPermission {
  id          String   @id @default(uuid())
  role        String
  canExecute  Boolean  @default(true)
  canApprove  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("action_permissions")
}

model ActionNotification {
  id          String   @id @default(uuid())
  recipientId String
  message     String
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@map("action_notifications")
