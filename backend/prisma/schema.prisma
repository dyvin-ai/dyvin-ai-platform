enum WorkflowStatus {
  PENDING
  DRAFT
  ACTIVE
  PAUSED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowNodeType {
  TRIGGER
  CONDITION
  ACTION
  AGENT
  APPROVAL
  DELAY
  WEBHOOK
}

enum WorkflowTriggerType {
  MANUAL
  SCHEDULE
  EVENT
  WEBHOOK
  VISIBILITY_CHANGED
  SCAN_FINISHED
  COMPETITOR_CHANGED
  RESEARCH_COMPLETED
  REPORT_GENERATED
}

enum WorkflowExecutionMode {
  SEQUENTIAL
  PARALLEL
  CONDITIONAL
}

enum WorkflowApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  TIMED_OUT
}

enum WorkflowEventType {
  TRIGGERED
  STEP_COMPLETED
  STEP_FAILED
  WAITING_APPROVAL
  WORKFLOW_COMPLETED
}

model Workflow {
  id             String                @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         WorkflowStatus        @default(DRAFT)
  mode           WorkflowExecutionMode @default(SEQUENTIAL)
  isTemplate     Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  versions       WorkflowVersion[]
  nodes          WorkflowNode[]
  edges          WorkflowEdge[]
  executions     WorkflowExecution[]
  runs           WorkflowRun[]

  @@index([organizationId])
  @@index([status])
  @@map("workflows")
}

model WorkflowVersion {
  id          String   @id @default(uuid())
  workflowId  String
  versionNum  Int      @default(1)
  definition  Json
  createdAt   DateTime @default(now())

  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   @default("RECOVER_VISIBILITY")
  description String
  nodesJson   Json
  edgesJson   Json
  createdAt   DateTime @default(now())

  @@map("workflow_templates")
}

