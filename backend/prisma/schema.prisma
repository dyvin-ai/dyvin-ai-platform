// ===============================================
// Sprint 24: AI Research Intelligence Platform
// ===============================================

enum ResearchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ResearchPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResearchType {
  COMPETITOR
  PRODUCT
  BLOG
  NEWS
  DOCUMENTATION
  COMMUNITY
  TREND
  OPPORTUNITY
  THREAT
}

enum ResearchFrequency {
  REALTIME
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum ResearchConfidenceLevel {
  LOW
  MEDIUM
  HIGH
  VERIFIED
}

enum ResearchSourceCategory {
  SEARCH_ENGINE
  SOCIAL_MEDIA
  DOCUMENTATION
  NEWS_OUTLET
  ACADEMIC
  FORUM
}

enum ResearchTrendDirection {
  RISING
  FALLING
  STABLE
  VOLATILE
}

model ResearchProject {
  id             String         @id @default(uuid())
  organizationId String
  title          String
  description    String?
  status         ResearchStatus @default(PENDING)
  priority       ResearchPriority @default(MEDIUM)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  topics         ResearchTopic[]
  findings       ResearchFinding[]
  reports        ResearchReport[]
  tasks          ResearchTask[]

  @@index([organizationId])
  @@index([status])
  @@map("research_projects")
}

model ResearchTopic {
  id               String          @id @default(uuid())
  projectId        String
  name             String
  description      String?
  createdAt        DateTime        @default(now())

  project          ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings         ResearchFinding[]
  trends           ResearchTrend[]

  @@index([projectId])
  @@map("research_topics")
}

model ResearchCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  @@map("research_categories")
}

model ResearchSource {
  id          String                 @id @default(uuid())
  name        String
  url         String
  category    ResearchSourceCategory @default(SEARCH_ENGINE)
  isEnabled   Boolean                @default(true)
  createdAt   DateTime               @default(now())

  documents   ResearchDocument[]

  @@map("research_sources")
}

model ResearchSourceType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  createdAt   DateTime @default(now())

  @@map("research_source_types")
}

model ResearchDocument {
  id          String         @id @default(uuid())
  sourceId    String
  title       String
  contentBody String
  url         String?
  fetchedAt   DateTime       @default(now())

  source      ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  citations   ResearchCitation[]

  @@index([sourceId])
  @@map("research_documents")
}

model ResearchFinding {
  id          String            @id @default(uuid())
  projectId   String
  topicId     String?
  title       String
  summary     String
  type        ResearchType      @default(TREND)
  confidence  ResearchConfidenceLevel @default(HIGH)
  createdAt   DateTime          @default(now())

  project     ResearchProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic       ResearchTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([topicId])
  @@map("research_findings")
}

model ResearchInsight {
  id          String   @id @default(uuid())
  title       String
  insightText String
  impactScore Float    @default(85.0)
  createdAt   DateTime @default(now())

  @@map("research_insights")
}

model ResearchTrend {
  id            String                 @id @default(uuid())
  topicId       String?
  keywordText   String
  direction     ResearchTrendDirection @default(RISING)
  growthRatePct Float                  @default(15.0)
  detectedAt    DateTime               @default(now())

  topic         ResearchTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@map("research_trends")
}

model ResearchOpportunity {
  id              String   @id @default(uuid())
  title           String
  description     String
  potentialImpact Float    @default(90.0)
  createdAt       DateTime @default(now())

  @@map("research_opportunities")
}

model ResearchThreat {
  id           String   @id @default(uuid())
  title        String
  description  String
  severity     String   @default("HIGH")
  detectedAt   DateTime @default(now())

  @@map("research_threats")
}

model ResearchGap {
  id          String   @id @default(uuid())
  gapType     String   @default("CONTENT_GAP")
  description String
  createdAt   DateTime @default(now())

  @@map("research_gaps")
}

model ResearchQuestion {
  id           String   @id @default(uuid())
  questionText String
  createdAt    DateTime @default(now())

  answers      ResearchAnswer[]

  @@map("research_questions")
}

model ResearchAnswer {
  id          String           @id @default(uuid())
  questionId  String
  answerText  String
  createdAt   DateTime         @default(now())

  question    ResearchQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("research_answers")
}

model ResearchEvidence {
  id           String   @id @default(uuid())
  evidenceText String
  sourceUrl    String?
  confidence   Float    @default(0.95)
  createdAt    DateTime @default(now())

  @@map("research_evidences")
}

model ResearchSummary {
  id          String   @id @default(uuid())
  title       String
  summaryText String
  createdAt   DateTime @default(now())

  @@map("research_summaries")
}

model ResearchSnapshot {
